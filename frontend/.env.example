# Keep empty for local Vite development: requests use same-origin /api and the
# Vite proxy below forwards them to the local Spring Boot service.
VITE_SRM_API_BASE=
# Optional local development proxy target. Do not use a production URL here.
VITE_SRM_API_PROXY_TARGET=http://127.0.0.1:18080
VITE_SRM_API_TIMEOUT_MS=15000

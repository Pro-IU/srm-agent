# Copy to .env only for local development. Do not commit credentials.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Safe local default: no model API key or external service is required.
SRM_RUNTIME_MODE=DEMO
SRM_LIVE_MODEL_PROVIDER=dashscope
SRM_LIVE_MODEL=
SRM_LIVE_MODEL_BASE_URL=
SRM_LIVE_MODEL_API_KEY=
SRM_LIVE_TIMEOUT_SECONDS=15
SRM_MAX_MESSAGE_LENGTH=2000

# Optional read-only knowledge-engine integration; disabled by default.
SRM_KNOWLEDGE_ENGINE_ENABLED=false
SRM_KNOWLEDGE_ENGINE_BASE_URL=http://localhost:8009
SRM_KNOWLEDGE_ENGINE_CONNECT_TIMEOUT_MS=1000
SRM_KNOWLEDGE_ENGINE_READ_TIMEOUT_MS=8000
SRM_KNOWLEDGE_ENGINE_MAX_RESULTS=5
SRM_KNOWLEDGE_ENGINE_MAX_CONTENT_LENGTH=1200
SRM_KNOWLEDGE_ENGINE_MAX_ATTEMPTS=1

# Local demo scripts (generated values live only in ignored .runtime/demo.env).
SRM_DEMO_BACKEND_PORT=18080
SRM_DEMO_FRONTEND_PORT=15173
SRM_DEMO_MYSQL_PORT=13306
SRM_MAVEN_OFFLINE=true
SRM_ALLOW_NPM_INSTALL=false
